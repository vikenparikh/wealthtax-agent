{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["*"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-secret-commit.sh"
          }
        ]
      }
    ]
  }
}
