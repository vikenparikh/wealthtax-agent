# Required
GROQ_API_KEY=gsk-...
WEALTHTAX_FERNET_KEY=  # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Mode
WEALTHTAX_MODE=saas             # saas | self_hosted

# Database
DATABASE_URL=sqlite:///./wealthtax.db
# Production example:
# DATABASE_URL=postgresql+psycopg://wealthtax:wealthtax@db:5432/wealthtax

# Optional
SESSION_TTL_MINUTES=1440
CORRECTION_RATE_PER_MINUTE=30
LOG_LEVEL=INFO
